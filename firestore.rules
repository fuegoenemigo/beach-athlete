rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function admitted(uid) {
      return exists(/databases/$(database)/documents/config/betaAccess)
        && uid in get(/databases/$(database)/documents/config/betaAccess).data.members;
    }

    match /config/betaAccess {
      allow get: if request.auth != null;
      allow list, create, delete: if false;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['limit', 'members'])
        && request.resource.data.limit == resource.data.limit
        && resource.data.members is list
        && request.resource.data.members is list
        && resource.data.members.size() < resource.data.limit
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members == resource.data.members.concat([request.auth.uid]);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && admitted(userId);
    }
  }
}
